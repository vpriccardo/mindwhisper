{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "mindwhisper",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/tx", "destination": "/tx.html" },
    { "source": "/rx", "destination": "/rx.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
